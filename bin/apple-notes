#!/usr/bin/env bun

const WRITE_FOLDER = "Agents";
const MAX_BODY_CHARS = 100_000;
const BACKEND_TIMEOUT_MS = 20_000;

const JXA = String.raw`
const WRITE_FOLDER = "Agents";
const MAX_BODY_CHARS = 100000;

function value(object, property) {
  try { return object[property](); } catch (_) { return undefined; }
}
function isShared(object) { return value(object, "shared") === true; }
function isProtected(note) { return value(note, "passwordProtected") === true; }
function foldersIn(container) { try { return container.folders(); } catch (_) { return []; } }
function notesIn(folder) { try { return folder.notes(); } catch (_) { return []; } }
function walkFolders(container, accountName, parentPath, output) {
  for (const folder of foldersIn(container)) {
    const name = String(value(folder, "name") || "");
    const path = parentPath ? parentPath + "/" + name : name;
    const shared = isShared(folder);
    output.push({ folder, accountName, name, path, shared });
    if (!shared) walkFolders(folder, accountName, path, output);
  }
}
function allFolders(notes) {
  const output = [];
  for (const account of notes.accounts()) {
    const accountName = String(value(account, "name") || "");
    walkFolders(account, accountName, "", output);
  }
  return output;
}
function publicFolder(record) {
  return {
    id: String(value(record.folder, "id") || ""),
    account: record.accountName,
    name: record.name,
    path: record.path,
    shared: record.shared,
  };
}
function isoDate(raw) {
  try { return raw ? raw.toISOString() : null; } catch (_) { return null; }
}
function publicNote(note, folderRecord, includeBody) {
  const plaintext = String(value(note, "plaintext") || "");
  const result = {
    id: String(value(note, "id") || ""),
    title: String(value(note, "name") || ""),
    account: folderRecord.accountName,
    folder: folderRecord.path,
    createdAt: isoDate(value(note, "creationDate")),
    modifiedAt: isoDate(value(note, "modificationDate")),
    plaintext: includeBody ? plaintext : plaintext.slice(0, 300),
  };
  if (includeBody) result.html = String(value(note, "body") || "");
  return result;
}
function readableFolders(notes) { return allFolders(notes).filter((record) => !record.shared); }
function findReadableNote(notes, noteId) {
  for (const folderRecord of readableFolders(notes)) {
    for (const note of notesIn(folderRecord.folder)) {
      if (isShared(note) || isProtected(note)) continue;
      if (String(value(note, "id") || "") === noteId) return { note, folderRecord };
    }
  }
  throw new Error("Note not found, shared, or password protected.");
}
function findWriteFolder(notes, create) {
  const account = notes.defaultAccount();
  let folder = foldersIn(account).find((candidate) => String(value(candidate, "name") || "") === WRITE_FOLDER);
  if (!folder && create) {
    folder = notes.Folder({ name: WRITE_FOLDER });
    account.folders.push(folder);
  }
  if (!folder) throw new Error(WRITE_FOLDER + " does not exist.");
  if (isShared(folder)) throw new Error(WRITE_FOLDER + " must not be shared.");
  return {
    folder,
    accountName: String(value(account, "name") || ""),
    name: WRITE_FOLDER,
    path: WRITE_FOLDER,
    shared: false,
  };
}
function positiveInt(raw, fallback, maximum) {
  const parsed = parseInt(String(raw || ""), 10);
  if (!isFinite(parsed) || parsed < 1) return fallback;
  return Math.min(parsed, maximum);
}
function main(argv) {
  const operation = argv[0];
  const notes = Application("Notes");
  if (operation === "folders") return readableFolders(notes).map(publicFolder);
  if (operation === "search") {
    const query = String(argv[1] || "").trim().toLowerCase();
    const limit = positiveInt(argv[2], 20, 50);
    if (!query) throw new Error("Search query is required.");
    const results = [];
    for (const folderRecord of readableFolders(notes)) {
      for (const note of notesIn(folderRecord.folder)) {
        if (isShared(note) || isProtected(note)) continue;
        const title = String(value(note, "name") || "");
        const plaintext = String(value(note, "plaintext") || "");
        if ((title + "\n" + plaintext).toLowerCase().includes(query)) {
          results.push(publicNote(note, folderRecord, false));
          if (results.length >= limit) return results;
        }
      }
    }
    return results;
  }
  if (operation === "get") {
    const noteId = String(argv[1] || "");
    if (!noteId) throw new Error("Note id is required.");
    const found = findReadableNote(notes, noteId);
    return publicNote(found.note, found.folderRecord, true);
  }
  if (operation === "create") {
    const title = String(argv[1] || "").trim();
    const html = String(argv[2] || "");
    if (!title) throw new Error("Title is required.");
    if (!html) throw new Error("Body is required.");
    if (html.length > MAX_BODY_CHARS) throw new Error("Body is too large.");
    const folderRecord = findWriteFolder(notes, true);
    const note = notes.Note({ body: html });
    folderRecord.folder.notes.push(note);
    return publicNote(note, folderRecord, true);
  }
  if (operation === "append") {
    const noteId = String(argv[1] || "");
    const html = String(argv[2] || "");
    if (!noteId) throw new Error("Note id is required.");
    if (!html) throw new Error("Body is required.");
    if (html.length > MAX_BODY_CHARS) throw new Error("Body is too large.");
    const folderRecord = findWriteFolder(notes, false);
    const note = notesIn(folderRecord.folder).find((candidate) => String(value(candidate, "id") || "") === noteId);
    if (!note || isShared(note) || isProtected(note)) {
      throw new Error("Append is restricted to unshared, unlocked notes in " + WRITE_FOLDER + ".");
    }
    const existing = String(value(note, "body") || "");
    note.body.set(existing + "<div><br></div>" + html);
    return publicNote(note, folderRecord, true);
  }
  throw new Error("Unknown operation: " + operation);
}
function run(argv) {
  try { return JSON.stringify({ ok: true, data: main(argv) }); }
  catch (error) { return JSON.stringify({ ok: false, error: String(error.message || error) }); }
}
`;

export function escapeHtml(text) {
	return text
		.replaceAll("&", "&amp;")
		.replaceAll("<", "&lt;")
		.replaceAll(">", "&gt;")
		.replaceAll('"', "&quot;")
		.replaceAll("'", "&#39;");
}

function bulletText(line) {
	const match = line.trim().match(/^(?:☐|•|[-*])\s+(.+)$/);
	return match?.[1];
}

export function textToHtml(text) {
	if (!text.trim()) throw new Error("Body is required.");
	if (text.length > MAX_BODY_CHARS) throw new Error(`Body exceeds ${MAX_BODY_CHARS} characters.`);
	const lines = text.replaceAll("\r\n", "\n").split("\n");
	const output = [];
	let list = [];

	function flushList() {
		if (list.length === 0) return;
		output.push(`<ul>${list.map((item) => `<li>${escapeHtml(item)}</li>`).join("")}</ul>`);
		list = [];
	}

	for (let index = 0; index < lines.length; index += 1) {
		const line = lines[index];
		const trimmed = line.trim();
		const bullet = bulletText(line);
		if (bullet) {
			list.push(bullet);
			continue;
		}
		if (!trimmed) {
			const next = lines.slice(index + 1).find((candidate) => candidate.trim());
			if (list.length > 0 && next && bulletText(next)) continue;
			flushList();
			if (output.at(-1) !== "<div><br></div>") output.push("<div><br></div>");
			continue;
		}
		flushList();
		const escaped = escapeHtml(trimmed);
		if (/^[A-Z][A-Z0-9 ()/&+-]{2,}$/.test(trimmed)) output.push(`<div><h2>${escaped}</h2></div>`);
		else output.push(`<div>${escaped}</div>`);
	}
	flushList();
	while (output[0] === "<div><br></div>") output.shift();
	while (output.at(-1) === "<div><br></div>") output.pop();
	return output.join("");
}

export function composeNoteHtml(title, body) {
	const cleanTitle = title.trim();
	if (!cleanTitle) throw new Error("Title is required.");
	return `<div><h1>${escapeHtml(cleanTitle)}</h1></div><div><br></div>${textToHtml(body)}`;
}

export function assertWriteAuthorized(args) {
	if (!args.includes("--confirm-write")) {
		throw new Error("Writes require --confirm-write and are restricted to Agents.");
	}
}

function option(args, name) {
	const index = args.indexOf(name);
	return index >= 0 ? args[index + 1] : undefined;
}

async function readBody(args) {
	const encoded = option(args, "--body-base64");
	if (encoded) return Buffer.from(encoded, "base64").toString("utf8");
	const path = option(args, "--body-file");
	if (!path) throw new Error("Provide --body-file PATH (or - for stdin).");
	return path === "-" ? await Bun.stdin.text() : await Bun.file(path).text();
}

export async function runBackend(args, timeoutMs = BACKEND_TIMEOUT_MS) {
	const process = Bun.spawn(["/usr/bin/osascript", "-l", "JavaScript", "-e", JXA, ...args], {
		stdout: "pipe",
		stderr: "pipe",
	});
	let timedOut = false;
	const timer = setTimeout(() => {
		timedOut = true;
		process.kill();
	}, timeoutMs);
	const [code, stdout, stderr] = await Promise.all([
		process.exited,
		new Response(process.stdout).text(),
		new Response(process.stderr).text(),
	]);
	clearTimeout(timer);
	if (timedOut) {
		throw new Error("Apple Notes automation timed out. Check the macOS Automation permission for Notes.");
	}
	if (code !== 0) throw new Error(stderr.trim() || `osascript exited ${code}`);
	const parsed = JSON.parse(stdout.trim());
	if (!parsed.ok) throw new Error(parsed.error || "Apple Notes operation failed.");
	return parsed.data;
}

function usage() {
	return `Usage:
  apple-notes folders
  apple-notes search QUERY [--limit 20]
  apple-notes get NOTE_ID
  apple-notes create --title TITLE --body-file PATH --confirm-write
  apple-notes append --id NOTE_ID --body-file PATH --confirm-write

Writes are restricted to the unshared "${WRITE_FOLDER}" folder. Use --body-file - to read stdin.`;
}

async function main(args) {
	const command = args[0];
	if (!command || command === "--help" || command === "help") {
		console.log(usage());
		return;
	}
	let data;
	if (command === "folders") data = await runBackend(["folders"]);
	else if (command === "search") {
		const query = args[1];
		if (!query) throw new Error("Search query is required.");
		data = await runBackend(["search", query, option(args, "--limit") ?? "20"]);
	} else if (command === "get") {
		if (!args[1]) throw new Error("Note id is required.");
		data = await runBackend(["get", args[1]]);
	} else if (command === "create") {
		assertWriteAuthorized(args);
		const title = option(args, "--title")?.trim();
		if (!title) throw new Error("Create requires --title.");
		data = await runBackend(["create", title, composeNoteHtml(title, await readBody(args))]);
	} else if (command === "append") {
		assertWriteAuthorized(args);
		const id = option(args, "--id");
		if (!id) throw new Error("Append requires --id.");
		data = await runBackend(["append", id, textToHtml(await readBody(args))]);
	} else throw new Error(`Unknown command: ${command}`);
	console.log(JSON.stringify(data, null, 2));
}

if (import.meta.main) {
	main(Bun.argv.slice(2)).catch((error) => {
		console.error(`apple-notes: ${error.message ?? error}`);
		process.exitCode = 1;
	});
}
