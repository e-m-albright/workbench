#!/usr/bin/env bun

const GROUP = "Operating Vault Managed";
const MAX_INPUT_CHARS = 20_000;
const TIMEOUT_MS = 20_000;

const JXA = String.raw`
const GROUP = "Operating Vault Managed";
const START = "[Operating Vault]";
const END = "[/Operating Vault]";
function value(object, property) { try { return object[property](); } catch (_) { return undefined; } }
function text(raw) { return raw === undefined || raw === null ? "" : String(raw); }
function entries(items) { try { return items().map((item) => ({ label: text(value(item, "label")), value: text(value(item, "value")) })); } catch (_) { return []; } }
function publicPerson(person) {
  return {
    id: text(value(person, "id")),
    name: text(value(person, "name")),
    firstName: text(value(person, "firstName")),
    lastName: text(value(person, "lastName")),
    organization: text(value(person, "organization")),
    jobTitle: text(value(person, "jobTitle")),
    note: text(value(person, "note")),
    emails: entries(person.emails),
    phones: entries(person.phones),
    urls: entries(person.urls),
    groups: (() => { try { return person.groups().map((g) => text(value(g, "name"))); } catch (_) { return []; } })(),
  };
}
function findPerson(contacts, id) {
  const found = contacts.people.whose({ id })();
  if (found.length !== 1) throw new Error(found.length ? "Contact id is ambiguous." : "Contact not found.");
  return found[0];
}
function managedNote(existing, block) {
  const start = existing.indexOf(START);
  const end = existing.indexOf(END);
  let outside = existing.trim();
  if (start >= 0 && end >= start) outside = (existing.slice(0, start) + existing.slice(end + END.length)).trim();
  return [outside, block.trim()].filter(Boolean).join("\n\n");
}
function normalizedInfo(kind, raw) {
  const value = text(raw).trim();
  return kind === "phone" ? value.replace(/\D/g, "") : value.toLowerCase();
}
function ensureInfo(contacts, person, collection, kind, label, wanted) {
  if (!wanted) return;
  const items = collection();
  const wantedKey = normalizedInfo(kind, wanted);
  const matches = items.filter((item) => normalizedInfo(kind, value(item, "value")) === wantedKey);
  if (matches.length > 0) {
    // Preserve the original entry and label. Remove only later duplicate values,
    // which are appended by this managed projection.
    for (const duplicate of matches.slice(1)) contacts.delete(duplicate);
    return;
  }
  const constructors = { email: contacts.Email, phone: contacts.Phone, url: contacts.Url };
  collection.push(constructors[kind]({ label, value: wanted }));
}
function ensureGroup(contacts, person) {
  let group = contacts.groups.whose({ name: GROUP })()[0];
  if (!group) { group = contacts.Group({ name: GROUP }); contacts.groups.push(group); }
  const member = group.people().some((candidate) => text(value(candidate, "id")) === text(value(person, "id")));
  if (!member) contacts.add(person, { to: group });
}
function applyPayload(contacts, person, payload) {
  person.firstName.set(payload.firstName || "");
  person.lastName.set(payload.lastName || "");
  person.organization.set(payload.organization || "");
  person.jobTitle.set(payload.jobTitle || "");
  person.note.set(managedNote(text(value(person, "note")), payload.managedNote || ""));
  ensureInfo(contacts, person, person.emails, "email", payload.emailLabel || "work", payload.email || "");
  ensureInfo(contacts, person, person.phones, "phone", payload.phoneLabel || "mobile", payload.phone || "");
  ensureInfo(contacts, person, person.urls, "url", "LinkedIn", payload.linkedin || "");
  ensureGroup(contacts, person);
}
function main(argv) {
  const operation = argv[0];
  const contacts = Application("Contacts");
  if (operation === "search") {
    const query = text(argv[1]).trim().toLowerCase();
    if (!query) throw new Error("Search query is required.");
    let matches = [];
    if (query.includes("@")) {
      // Contacts scripting has no reliable nested whose predicate for email.
      // Inspect only email values here; expanding every full card is ~60s for
      // a few hundred contacts. Full properties are fetched for matches only.
      for (const person of contacts.people()) {
        if (entries(person.emails).some((entry) => entry.value.toLowerCase().includes(query))) matches.push(person);
      }
    } else if (/\d{4}/.test(query)) {
      const digits = query.replace(/\D/g, "");
      for (const person of contacts.people()) {
        if (entries(person.phones).some((entry) => entry.value.replace(/\D/g, "").includes(digits))) matches.push(person);
      }
    } else {
      const seen = {};
      const add = (person) => { const id = text(value(person, "id")); if (!seen[id]) { seen[id] = true; matches.push(person); } };
      for (const person of contacts.people.whose({ name: { _contains: query } })()) add(person);
      for (const person of contacts.people.whose({ organization: { _contains: query } })()) add(person);
    }
    return matches.slice(0, 25).map(publicPerson);
  }
  if (operation === "get") return publicPerson(findPerson(contacts, text(argv[1])));
  const payload = JSON.parse(text(argv[1]));
  if (operation === "create") {
    const person = contacts.Person({});
    contacts.people.push(person);
    applyPayload(contacts, person, payload);
    contacts.save();
    return publicPerson(person);
  }
  if (operation === "update") {
    const person = findPerson(contacts, text(argv[2]));
    applyPayload(contacts, person, payload);
    contacts.save();
    return publicPerson(person);
  }
  throw new Error("Unknown operation: " + operation);
}
function run(argv) { try { return JSON.stringify({ ok: true, data: main(argv) }); } catch (error) { return JSON.stringify({ ok: false, error: text(error.message || error) }); } }
`;

export function assertWriteAuthorized(args: string[]): void {
	if (!args.includes("--confirm-write")) throw new Error("Contact writes require --confirm-write.");
}

export function validatePayload(raw: unknown): Record<string, string> {
	if (!raw || typeof raw !== "object" || Array.isArray(raw)) throw new Error("Contact payload must be an object.");
	const allowed = new Set(["firstName", "lastName", "organization", "jobTitle", "email", "emailLabel", "phone", "phoneLabel", "linkedin", "managedNote"]);
	const payload: Record<string, string> = {};
	for (const [key, value] of Object.entries(raw)) {
		if (!allowed.has(key) || typeof value !== "string") throw new Error(`Invalid contact field: ${key}`);
		payload[key] = value;
	}
	if (!(payload.firstName || payload.lastName)) throw new Error("A first or last name is required.");
	if (!payload.managedNote?.includes("Person ID:")) throw new Error("Managed note must contain Person ID.");
	return payload;
}

async function backend(args: string[]): Promise<unknown> {
	const child = Bun.spawn(["/usr/bin/osascript", "-l", "JavaScript", "-e", JXA, ...args], { stdout: "pipe", stderr: "pipe" });
	let timedOut = false;
	const timer = setTimeout(() => { timedOut = true; child.kill(); }, TIMEOUT_MS);
	const [code, stdout, stderr] = await Promise.all([child.exited, new Response(child.stdout).text(), new Response(child.stderr).text()]);
	clearTimeout(timer);
	if (timedOut) throw new Error("Contacts automation timed out. Check macOS Automation permission for Contacts.");
	if (code !== 0) throw new Error(stderr.trim() || `osascript exited ${code}`);
	const parsed = JSON.parse(stdout.trim());
	if (!parsed.ok) throw new Error(parsed.error || "Contacts operation failed.");
	return parsed.data;
}

async function readPayload(): Promise<Record<string, string>> {
	const body = await Bun.stdin.text();
	if (!body || body.length > MAX_INPUT_CHARS) throw new Error("Contact payload is missing or too large.");
	return validatePayload(JSON.parse(body));
}

function usage(): string {
	return `Usage:\n  apple-contacts search QUERY\n  apple-contacts get CONTACT_ID\n  apple-contacts create --confirm-write < payload.json\n  apple-contacts update CONTACT_ID --confirm-write < payload.json\n\nWrites add the contact to “${GROUP}” and preserve notes outside the managed block.`;
}

async function main(args: string[]): Promise<void> {
	const command = args[0];
	if (!command || command === "help" || command === "--help") { console.log(usage()); return; }
	let data: unknown;
	if (command === "search") {
		if (!args[1]) throw new Error("Search query is required.");
		data = await backend(["search", args[1]]);
	} else if (command === "get") {
		if (!args[1]) throw new Error("Contact id is required.");
		data = await backend(["get", args[1]]);
	} else if (command === "create") {
		assertWriteAuthorized(args);
		data = await backend(["create", JSON.stringify(await readPayload())]);
	} else if (command === "update") {
		assertWriteAuthorized(args);
		if (!args[1]) throw new Error("Contact id is required.");
		data = await backend(["update", JSON.stringify(await readPayload()), args[1]]);
	} else throw new Error(`Unknown command: ${command}`);
	console.log(JSON.stringify(data, null, 2));
}

if (import.meta.main) main(Bun.argv.slice(2)).catch((error) => { console.error(`apple-contacts: ${error.message ?? error}`); process.exitCode = 1; });
